{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tree-rag-runs/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "data_version", "manifest_hash", "generated_at", "arms", "models", "rows"],
  "properties": {
    "schema": {"const": "tree-rag-runs/v1"},
    "data_version": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generated_at": {"type": "string"},
    "arms": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "family"],
      "properties": {"id": {"type": "string"}, "label": {"type": "string"},
                     "family": {"enum": ["oracle", "vector", "tree", "hybrid", "long_context"]}}}},
    "models": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "local", "roles"],
      "properties": {"id": {"type": "string"}, "local": {"type": "boolean"},
                     "roles": {"type": "array", "items": {"enum": ["answerer", "navigator", "judge"]}}}}},
    "rows": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["qid", "dataset", "regime", "qtype", "arm", "navigator", "answerer", "correct", "judge",
                   "evidence_recall", "evidence_precision", "wrong_doc", "latency_s", "llm_calls_sequential",
                   "tokens_query", "tokens_index_amortised", "cost_usd", "gpu_s", "failure"],
      "properties": {
        "qid": {"type": "string"}, "dataset": {"type": "string"},
        "regime": {"enum": ["A", "B", "claim"]},
        "qtype": {"enum": ["lookup", "table", "computation", "cross_doc", "disambiguation", "unanswerable"]},
        "form": {"enum": ["isin", "description", null]},
        "arm": {"type": "string"}, "navigator": {"type": "string"}, "answerer": {"type": "string"},
        "correct": {"type": ["boolean", "null"]},
        "judge": {"type": ["string", "null"]},
        "evidence_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "wrong_doc": {"type": ["boolean", "null"]},
        "latency_s": {"type": ["number", "null"], "minimum": 0},
        "llm_calls_sequential": {"type": ["integer", "null"], "minimum": 0},
        "tokens_query": {"type": ["integer", "null"], "minimum": 0},
        "tokens_index_amortised": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "gpu_s": {"type": ["number", "null"], "minimum": 0},
        "failure": {"enum": [null, "answered_unanswerable", "wrong_doc", "parse_failure", "wrong_page",
                             "right_evidence_wrong_answer", "not_applicable", "error"]}
      }}}
  }
}
