{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tree-rag gold question v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["qid", "dataset", "regime", "qtype", "question", "doc_ids", "gold", "evidence", "verified_by"],
  "properties": {
    "qid": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "dataset": {"type": "string", "minLength": 1},
    "regime": {"enum": ["A", "B", "claim"]},
    "qtype": {"enum": ["lookup", "table", "computation", "cross_doc", "disambiguation", "unanswerable"]},
    "question": {"type": "string", "minLength": 5},
    "doc_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["exact", "numeric", "date", "date_list", "free", "unanswerable"]},
        "value": {"type": ["string", "array", "null"], "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["doc_id", "page"],
        "properties": {"doc_id": {"type": "string"}, "page": {"type": "integer", "minimum": 1}}
      }
    },
    "verified_by": {"type": "string", "minLength": 1}
  }
}
